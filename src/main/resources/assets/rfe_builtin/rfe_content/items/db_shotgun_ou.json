{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 13,
    "sound": "rfe_builtin:item.generic.shotgun.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 5,
    "aim_sound": "rfe_builtin:item.generic.shotgun.aim",
    "unaim_sound": "rfe_builtin:item.generic.shotgun.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "internal_capacity": 2,
    "track_empty_slots": true
  },
  "firing": {
    "fire_mode": "semi_auto",
    "cooldown": 4,
    "ammo_consumed_last": false,
    "ignore_empty_slots_when_firing": true,
    "shots_fired": 1,
    "sound": "rfe_builtin:item.generic.shotgun.shot"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 16,
        "sound": "rfe_builtin:item.generic.shotgun.break_action.open"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than_or_equal_to", "value": 2 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 2 }
          ]
        },
        "time": 28,
        "reload_type": "rounds",
        "reload_count": 2,
        "reload_delays": [ 12, 24 ],
        "ammo_added_last": false,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" },
          { "time": 22, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than_or_equal_to", "value": 1 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 1 }
          ]
        },
        "time": 16,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 12,
        "ammo_added_last": false,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" }
        ]
      },
      {
        "phase": "finish",
        "time": 16,
        "charge_firearm": true,
        "sound": "rfe_builtin:item.generic.shotgun.break_action.close"
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "less_than", "value": 2 },
        "time": 16,
        "sound": "rfe_builtin:item.generic.shotgun.break_action.open"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "less_than", "value": 2 },
        "time": 16,
        "unload_type": "rounds",
        "unload_count": 1,
        "unload_delay": 12,
        "ammo_removed_last": true,
        "end_unload": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.shotgun.unload.shell" }
        ]
      },
      {
        "phase": "finish",
        "time": 16,
        "sound": "rfe_builtin:item.generic.shotgun.break_action.close"
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
