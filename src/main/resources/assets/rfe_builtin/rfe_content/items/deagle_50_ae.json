{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 11,
    "sound": "rfe_builtin:item.generic.pistol.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 2,
    "aim_sound": "rfe_builtin:item.generic.pistol.aim",
    "unaim_sound": "rfe_builtin:item.generic.pistol.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "plus_1_capacity": true
  },
  "firing": {
    "fire_mode": "semi_auto",
    "rpm": 220,
    "sound": "rfe_builtin:item.generic.pistol.shot.powerful"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
                {
                  "and": [
                    { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
                    { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than", "value": 0 }
                  ]
                }
              ]
            }
          ]
        },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 25,
        "unload_type": "magazines",
        "unload_time": 25,
        "sounds": [
          { "time": 5, "sound": "rfe_builtin:item.generic.pistol.magazine.unload" }
        ],
        "accessible_phases": {
          "reload": "all",
          "finish": "all"
        }
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 28,
        "reload_type": "magazines",
        "reload_time": 28,
        "sounds": [
          { "time": 5, "sound": "rfe_builtin:item.generic.pistol.magazine.reload" }
        ],
        "accessible_phases": {
          "finish": "all"
        }
      },
      {
        "phase": "finish",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 0 },
        "time": 9,
        "charge_firearm": true,
        "sounds": [
          { "time": 5, "sound": "rfe_builtin:item.generic.pistol.rack.end" }
        ]
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "or": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 }
          ]
        },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 25,
        "unload_type": "magazines",
        "unload_time": 25,
        "sound": "rfe_builtin:item.generic.pistol.magazine.unload"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 9,
        "unload_type": "rounds",
        "unload_count": 1,
        "unload_delay": 9,
        "sound": "rfe_builtin:item.generic.pistol.rack"
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 12,
        "sound": "rfe_builtin:item.generic.pistol.rack"
      }
    ]
  },
  "melee": {
    "can_melee": true,
    "melee_attack_speed": 0.5,
    "melee_attack_damage": 4.5,
    "enter_melee_window_time": 10,
    "exit_melee_time": 10
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      },
      "charge": {
        "actions": [
        ]
      }
    }
  }
}