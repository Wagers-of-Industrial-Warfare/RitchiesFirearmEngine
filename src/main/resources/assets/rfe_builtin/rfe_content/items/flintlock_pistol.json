{
  "type": "ritchiesfirearmengine:firearm",
  "reset_charge_on_unequip": true,
  "drawing": {
    "draw_time": 11,
    "sound": "rfe_builtin:item.generic.pistol.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.pistol.hammer.cocked"
  },
  "aiming": {
    "aim_time": 2,
    "aim_sound": "rfe_builtin:item.generic.pistol.aim",
    "unaim_sound": "rfe_builtin:item.generic.pistol.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "internal_capacity": 1
  },
  "firing": {
    "fire_mode": "single_action",
    "cooldown": 16,
    "charging_behavior": "manual",
    "sound": "rfe_builtin:item.generic.pistol.shot.black_powder",
    "can_dry_fire": true,
    "misfire": {
      "chances": {
        "ritchiesfirearmengine:when_raining": 0.85,
        "ritchiesfirearmengine:when_submerged": 1
      }
    },
    "wind_up": {
      "time": 2,
      "can_interrupt_wind_up": false,
      "sound": "rfe_builtin:item.generic.pistol.fired.click"
    }
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 12,
        "sound": "rfe_builtin:item.generic.pistol.hammer.cocked"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 150,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 150,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.pistol.gunpowder.pour" },
          { "time": 30, "sound": "rfe_builtin:item.generic.pistol.gunpowder.pour" },
          { "time": 50, "sound": "rfe_builtin:item.generic.pistol.ramrod.draw" },
          { "time": 75, "sound": "rfe_builtin:item.generic.pistol.ramrod.insert" },
          { "time": 90, "sound": "rfe_builtin:item.generic.pistol.ramrod.ram" },
          { "time": 95, "sound": "rfe_builtin:item.generic.pistol.ramrod.ram" },
          { "time": 100, "sound": "rfe_builtin:item.generic.pistol.ramrod.ram" },
          { "time": 110, "sound": "rfe_builtin:item.generic.pistol.ramrod.draw" },
          { "time": 130, "sound": "rfe_builtin:item.generic.pistol.ramrod.insert" }
        ]
      },
      {
        "phase": "finish",
        "time": 12,
        "sound": "rfe_builtin:item.generic.pistol.hammer.cocked"
      }
    ]
  },
  "unload": {
    "phases": [
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": {
          "or": [
            { "compare": "ritchiesfirearmengine:is_charged", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:is_jammed", "operator": "equals", "value": 1 }
          ]
        },
        "time": 12,
        "sound": "rfe_builtin:item.generic.pistol.hammer.cocked"
      }
    ]
  },
  "melee": {
    "can_melee": true,
    "melee_attack_speed": 0.85,
    "melee_attack_damage": 3,
    "enter_melee_window_time": 10,
    "exit_melee_time": 10
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    }
  }
}