{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 13,
    "sound": "rfe_builtin:item.generic.shotgun.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 5,
    "aim_sound": "rfe_builtin:item.generic.shotgun.aim",
    "unaim_sound": "rfe_builtin:item.generic.shotgun.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "internal_capacity": 8
  },
  "firing": {
    "fire_mode": "semi_auto",
    "rpm": 240,
    "sound": "rfe_builtin:item.generic.shotgun.shot"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 8
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 1 }
          ]
        },
        "time": 28,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 17,
        "replace_chambered_round": true,
        "charge_firearm": true,
        "sounds": [
          { "time": 0, "sound": "rfe_builtin:item.generic.shotgun.rack.start" },
          { "time": 15, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" },
          { "time": 20, "sound": "rfe_builtin:item.generic.shotgun.rack.end" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than_or_equal_to", "value": 2 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 2 }
          ]
        },
        "time": 22,
        "reload_type": "rounds",
        "reload_count": 2,
        "reload_delays": [8, 16],
        "replace_chambered_round": false,
        "sounds": [
          { "time": 6, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" },
          { "time": 14, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 1 }
          ]
        },
        "time": 15,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 8,
        "replace_chambered_round": false,
        "sounds": [
          { "time": 6, "sound": "rfe_builtin:item.generic.shotgun.reload.shell" }
        ]
      },
      {
        "phase": "finish",
        "time": 8,
        "charge_firearm": true
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 4,
        "sound": "rfe_builtin:item.generic.shotgun.rack"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 1,
        "unload_type": "rounds",
        "sound": "rfe_builtin:item.generic.shotgun.unload.shell",
        "accessible_phases": {
          "finish": "all"
        }
      },
      {
        "phase": "finish",
        "time": 4
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 9,
        "sound": "rfe_builtin:item.generic.shotgun.rack"
      }
    ]
  },
  "melee": {
    "can_melee": true,
    "melee_attack_speed": 0.5,
    "melee_attack_damage": 4.5,
    "enter_melee_window_time": 10,
    "exit_melee_time": 10
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    }
  }
}