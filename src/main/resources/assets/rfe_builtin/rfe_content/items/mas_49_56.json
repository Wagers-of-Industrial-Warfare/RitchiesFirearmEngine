{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 18,
    "sound": "rfe_builtin:item.generic.rifle.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 5,
    "aim_sound": "rfe_builtin:item.generic.rifle.aim",
    "unaim_sound": "rfe_builtin:item.generic.rifle.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "plus_1_capacity": true
  },
  "firing": {
    "fire_mode": "semi_auto",
    "rpm": 300,
    "sound": "rfe_builtin:item.generic.semi_auto_rifle.shot"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            {
              "or": [
                { "macro": "rfe_builtin:can_load_1_detachable" },
                { "macro": "rfe_builtin:can_load_1_extra_detachable" }
              ]
            },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 },
                { "compare": "ritchiesfirearmengine:best_speedloader_ammo_count", "operator": "greater_than", "value": 0 }
              ]
            }
          ]
        },
        "time": 13,
        "sound": "rfe_builtin:item.generic.rifle.rack_start"
      },
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
                {
                  "and": [
                    { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
                    { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than", "value": 0 }
                  ]
                }
              ]
            }
          ]
        },
        "time": 1
      },
      {
        "phase": "reload",
        "condition": {
          "macro": "rfe_builtin:can_strip_5_detachable"
        },
        "time": 25,
        "reload_type": "speedloaders",
        "reload_count": 5,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.stripper_clip.5rds"
      },
      {
        "phase": "reload",
        "condition": {
          "macro": "rfe_builtin:can_strip_4_detachable"
        },
        "time": 25,
        "reload_type": "speedloaders",
        "reload_count": 4,
        "reload_delay": 20,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.stripper_clip.5rds"
      },
      {
        "phase": "reload",
        "condition": {
          "macro": "rfe_builtin:can_strip_3_detachable"
        },
        "time": 25,
        "reload_type": "speedloaders",
        "reload_count": 3,
        "reload_delay": 20,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.stripper_clip.5rds"
      },
      {
        "phase": "reload",
        "condition": {
          "macro": "rfe_builtin:can_strip_2_detachable"
        },
        "time": 25,
        "reload_type": "speedloaders",
        "reload_count": 2,
        "reload_delay": 20,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.stripper_clip.5rds"
      },
      {
        "phase": "reload",
        "condition": {
          "macro": "rfe_builtin:can_strip_1_detachable"
        },
        "time": 25,
        "reload_type": "speedloaders",
        "reload_count": 1,
        "reload_delay": 20,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.stripper_clip.5rds"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_3_detachable" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 3 }
          ]
        },
        "time": 35,
        "reload_type": "rounds",
        "reload_count": 3,
        "reload_delays": [12, 17, 22],
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 15, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 20, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_2_detachable" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 2 }
          ]
        },
        "time": 30,
        "reload_type": "rounds",
        "reload_count": 2,
        "reload_delays": [12, 17],
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 15, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1_detachable" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 1 }
          ]
        },
        "time": 25,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 12,
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1_extra_detachable" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 25,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 12,
        "replace_chambered_round": true,
        "sound": "rfe_builtin:item.generic.rifle.bullet_reload"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 28,
        "reload_type": "magazines",
        "reload_time": 15,
        "sound": "rfe_builtin:item.generic.rifle.magazine.reload"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 58,
        "reload_type": "magazines",
        "unload_time": 20,
        "reload_time": 45,
        "sound": "rfe_builtin:item.generic.rifle.magazine.reload_full"
      },
      {
        "phase": "finish",
        "time": 13,
        "charge_firearm": true,
        "sound": "rfe_builtin:item.generic.rifle.rack_end"
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "or": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 }
          ]
        },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 25,
        "unload_type": "rounds",
        "unload_count": 1,
        "sound": "rfe_builtin:item.generic.rifle.rack"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 30,
        "unload_type": "magazines",
        "unload_time": 20,
        "sound": "rfe_builtin:item.generic.rifle.magazine.unload"
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 25,
        "sound": "rfe_builtin:item.generic.rifle.rack"
      }
    ]
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    }
  }
}