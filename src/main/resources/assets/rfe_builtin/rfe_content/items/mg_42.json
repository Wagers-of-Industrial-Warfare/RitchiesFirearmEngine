{
  "type": "ritchiesfirearmengine:firearm",
  "firearm_attachments": {
    "rfe_builtin:bipod": {
      "type": "ritchiesfirearmengine:bipod",
      "integral_attachment": true,
      "default_settings": {"ritchiesfirearmengine:deployed_setting": true}
    }
  },
  "magazine_attachment_slot": "rfe_builtin:magazine",
  "item_length": 2,
  "drawing": {
    "draw_time": 25,
    "sound": "rfe_builtin:item.generic.machine_gun.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 5,
    "aim_sound": "rfe_builtin:item.generic.machine_gun.aim",
    "unaim_sound": "rfe_builtin:item.generic.machine_gun.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "plus_1_capacity": false
  },
  "firing": {
    "fire_mode": "full_auto",
    "rpm": 1200,
    "sound": "rfe_builtin:item.generic.machine_gun.shot.old"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
                {
                  "and": [
                    { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
                    { "compare": "ritchiesfirearmengine:better_magazine_exists", "operator": "equals", "value": 1 }
                  ]
                }
              ]
            }
          ]
        },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 42,
        "unload_type": "magazines",
        "unload_time": 15,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.machine_gun.magazine.unload" }
        ],
        "accessible_phases": {
          "reload": "all",
          "finish": "all"
        }
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 40,
        "reload_type": "magazines",
        "reload_time": 15,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.machine_gun.magazine.reload" }
        ],
        "accessible_phases": {
          "finish": "all"
        }
      },
      {
        "phase": "finish",
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 34,
        "charge_firearm": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.machine_gun.rack" }
        ]
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 42,
        "unload_type": "magazines",
        "unload_time": 15,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.machine_gun.magazine.unload" }
        ],
        "accessible_phases": {
          "reload": "all",
          "finish": "all"
        }
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 20,
        "sound": "rfe_builtin:item.generic.machine_gun.rack"
      }
    ]
  },
  "melee": {
    "can_melee": false
  },
  "overheating": {
    "cant_overheat": false,
    "heat_capacity": 98,
    "heat_removed_per_tick": 2,
    "heat_removed_on_charge": 20,
    "heat_added_on_firing": 2,
    "cooling_delay_time": 10,
    "cooldown_time": 45,
    "sound": "rfe_builtin:item.generic.machine_gun.overheat"
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    }
  }
}