{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 16,
    "sound": "rfe_builtin:item.generic.smg.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 2,
    "aim_sound": "rfe_builtin:item.generic.smg.aim",
    "unaim_sound": "rfe_builtin:item.generic.smg.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "plus_1_capacity": false
  },
  "firing": {
    "fire_mode": "full_auto",
    "rpm": 800,
    "sound": "rfe_builtin:item.generic.smg.shot"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
                {
                  "and": [
                    { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
                    { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than", "value": 0 }
                  ]
                }
              ]
            }
          ]
        },
        "time": 1
      },
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 0 },
            {
              "or": [
                { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
                {
                  "and": [
                    { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
                    { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than", "value": 0 }
                  ]
                }
              ]
            }
          ]
        },
        "time": 15,
        "sound": "rfe_builtin:item.generic.smg.rack.start"
      },
      {
        "phase": "unload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 20,
        "unload_type": "magazines",
        "unload_time": 14,
        "sounds": [
          { "time": 9, "sound": "rfe_builtin:item.generic.smg.magazine.unload" }
        ],
        "accessible_phases": {
          "reload": "all",
          "finish": "all"
        }
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_has_magazine", "operator": "equals", "value": 1 }
          ]
        },
        "time": 20,
        "reload_type": "magazines",
        "reload_time": 14,
        "sounds": [
          { "time": 9, "sound": "rfe_builtin:item.generic.smg.magazine.reload" }
        ],
        "accessible_phases": {
          "finish": "all"
        }
      },
      {
        "phase": "finish",
        "condition": { "compare": "ritchiesfirearmengine:is_charged", "operator": "equals", "value": 0 },
        "time": 12,
        "charge_firearm": true,
        "sound": "rfe_builtin:item.generic.smg.rack.end"
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 1
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:firearm_has_magazine", "operator": "equals", "value": 1 },
        "time": 25,
        "unload_type": "magazines",
        "sound": "rfe_builtin:item.generic.smg.magazine.unload"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 19,
        "unload_type": "rounds",
        "unload_count": 1,
        "unload_delay": 13,
        "sound": "rfe_builtin:item.generic.smg.rack"
      },
      {
        "phase": "finish",
        "time": 1
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": { "macro": "rfe_builtin:can_charge" },
        "time": 24,
        "sound": "rfe_builtin:item.generic.smg.rack"
      }
    ]
  },
  "melee": {
    "can_melee": true,
    "melee_attack_speed": 0.6,
    "melee_attack_damage": 3.5,
    "enter_melee_window_time": 10,
    "exit_melee_time": 10
  },
  "modes": {
    "semi_auto": {
      "firing": {
        "fire_mode": "semi_auto",
        "cooldown": 2,
        "sound": "rfe_builtin:item.generic.smg.shot"
      }
    },
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    }
  }
}