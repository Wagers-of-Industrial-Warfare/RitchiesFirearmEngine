        "sound": "rfe_builtin:item.generic.rifle.bullet_unload"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "less_than_or_equal_to", "value": 3 },
