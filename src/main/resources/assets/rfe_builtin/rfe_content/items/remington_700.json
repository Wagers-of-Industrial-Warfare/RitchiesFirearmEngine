{
  "type": "ritchiesfirearmengine:firearm",
  "drawing": {
    "draw_time": 18,
    "sound": "rfe_builtin:item.generic.rifle.draw"
  },
  "mode_change": {
    "mode_change_time": 1,
    "sound": "rfe_builtin:item.generic.firearm.mode_change.switch"
  },
  "aiming": {
    "aim_time": 5,
    "aim_sound": "rfe_builtin:item.generic.rifle.aim",
    "unaim_sound": "rfe_builtin:item.generic.rifle.unaim"
  },
  "ammo": {
    "ammo_required": true,
    "internal_capacity": 5
  },
  "firing": {
    "fire_mode": "single_action",
    "cooldown": 2,
    "sound": "rfe_builtin:item.generic.rifle.shot"
  },
  "reload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than", "value": 0 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than", "value": 0 }
          ]
        },
        "time": 15,
        "sound": "rfe_builtin:item.generic.rifle.bolt_cycle_start"
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than_or_equal_to", "value": 3 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 3 }
          ]
        },
        "time": 39,
        "reload_type": "rounds",
        "reload_count": 3,
        "reload_delays": [12, 19, 26],
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 17, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 24, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "greater_than_or_equal_to", "value": 2 },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 2 }
          ]
        },
        "time": 32,
        "reload_type": "rounds",
        "reload_count": 2,
        "reload_delays": [12, 19],
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" },
          { "time": 17, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "reload",
        "condition": {
          "and": [
            { "macro": "rfe_builtin:can_load_1" },
            { "compare": "ritchiesfirearmengine:entity_ammo_count", "operator": "greater_than_or_equal_to", "value": 1 }
          ]
        },
        "time": 25,
        "reload_type": "rounds",
        "reload_count": 1,
        "reload_delay": 12,
        "replace_chambered_round": true,
        "sounds": [
          { "time": 10, "sound": "rfe_builtin:item.generic.rifle.bullet_reload" }
        ]
      },
      {
        "phase": "finish",
        "time": 15,
        "charge_firearm": true,
        "sound": "rfe_builtin:item.generic.rifle.bolt_cycle_end"
      }
    ]
  },
  "unload": {
    "phases": [
      {
        "phase": "prepare",
        "condition": { "compare": "ritchiesfirearmengine:free_ammo_space", "operator": "less_than", "value": 5 },
        "time": 15,
        "sound": "rfe_builtin:item.generic.rifle.bolt_cycle_start"
      },
      {
        "phase": "unload",
        "condition": { "compare": "ritchiesfirearmengine:has_chambered_round", "operator": "equals", "value": 1 },
        "time": 1,
        "unload_type": "rounds",
        "end_unload": true,
        "sound": "rfe_builtin:item.generic.rifle.bullet_unload"
      },
      {
        "phase": "finish",
        "time": 15,
        "sound": "rfe_builtin:item.generic.rifle.bolt_cycle_end"
      }
    ]
  },
  "charge": {
    "actions": [
      {
        "condition": {
          "or": [
            { "compare": "ritchiesfirearmengine:is_charged", "operator": "equals", "value": 0 },
            { "compare": "ritchiesfirearmengine:is_jammed", "operator": "equals", "value": 1 }
          ]
        },
        "time": 22,
        "sound": "rfe_builtin:item.generic.rifle.bolt_cycle"
      }
    ]
  },
  "modes": {
    "safety": {
      "firing": {
        "fire_mode": "safety"
      }
    },
    "locked_safety": {
      "firing": {
        "fire_mode": "safety"
      },
      "reload": {
        "phases": [
        ]
      },
      "unload": {
        "phases": [
        ]
      },
      "charge": {
        "actions": [
        ]
      }
    }
  }
}